---
import AgencyHero from '../components/AgencyHero.astro';

import Portfolio from '../layouts/Portfolio.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import PortfolioContact from '../components/PortfolioContact.astro';
import MockupAccordion from '../components/MockupAccordion.astro';
import { projects } from '../lib/portfolio';
import { url } from '../lib/content';
import '../styles/pricing.css';
const selectedProjects = ['sift-and-saffron', 'noura-beauty-house', 'crumb-and-cup', 'serenas-sanctuary', 'the-table-restaurant', 'loom-and-kiln', 'brightpath-academy', 'second-story', 'les-mots-dun-montagnard', 'her-circle'].map(slug => projects.find(project => project.slug === slug)!);
const oneTimeOffers = [
  { name: 'One-page website', price: '350', unit: 'AED', description: 'A clear starting point for a small business.', features: ['Up to six sections', 'Mobile layout', 'Contact links', 'Basic search setup'] },
  { name: 'Business website', price: '500', unit: 'AED', description: 'A small, practical home for your services.', features: ['Up to five simple pages', 'Mobile layout', 'One revision round'] },
  { name: 'Complete launch', price: '1,000', unit: 'AED', description: 'Website, identity and matching social profiles.', features: ['Business website + starter identity', 'Instagram + Facebook setup', 'Client-supplied text and photos'] },
  { name: 'Starter visual identity', price: '300', unit: 'AED', description: 'Logo design on its own, ready to use online and in print.', features: ['Two design directions', 'Two revision rounds', 'Final SVG and transparent PNG files'], info: 'The 300 AED logo package includes two design directions, two rounds of revisions and final SVG and transparent PNG files. The expanded starter identity is available for 600 AED and adds a colour palette, font pairing, short guidelines and a profile image.' },
  { name: 'Instagram + Facebook setup', price: '150', unit: 'AED', description: 'Both social profiles, with matching existing branding.', features: ['Instagram business account', 'Facebook business Page', 'Matching images and details'] },
  { name: 'Website + identity', price: '900', unit: 'AED', description: 'A grouped launch offer for your website and visual identity.', features: ['Business website', 'Starter visual identity'] },
  { name: 'Complete launch + domain', price: '1,150', unit: 'AED upfront', description: 'A complete launch, including the first year of web address and hosting setup.', features: ['Business website + starter identity', 'Instagram + Facebook setup', 'First-year domain and static hosting add-on'] },
] ;
const careOffers = [
  { name: 'Web address & hosting', price: '150', unit: 'AED · first year', description: 'A simple, managed start for a standard available web address.', features: ['Domain costing up to 75 AED', 'Static hosting setup and HTTPS', 'Domain connection', 'Choose the domain with your approval; register it in your name'] },
  { name: 'Chosen or premium domain', price: '150', unit: 'AED + domain cost above 75 AED', description: 'The same setup with the exact domain cost agreed before purchase.', features: ['Standard domain and hosting setup', 'Your approval before any extra domain cost', 'The domain is registered in your name'] },
  { name: 'Pay as you go', price: 'From 50', unit: 'AED / update', description: 'For a small change when you need one.', features: ['Small text, price, photo or link changes', 'Quote approved before work begins', 'Time includes review, editing, checks and publishing'] },
  { name: 'Website Care', price: '100', unit: 'AED / month', description: 'Regular checks and a little room for content updates.', features: ['Monthly link and contact checks', 'Source backup', 'Up to 30 minutes of updates', 'One grouped monthly batch'] },
  { name: 'Website Care Plus', price: '200', unit: 'AED / month', description: 'More update time and a small monthly promotion.', features: ['Monthly link and contact checks', 'Source backup', 'Up to 90 minutes of updates', 'Two grouped batches', 'One small promotional banner per month'] },
  { name: 'Annual renewal management', price: '75', unit: 'AED / year + provider charges', description: 'A yearly reminder and connection check, handled for you.', features: ['Renewal management', 'Check that the website remains connected', 'Provider charges billed separately'] },
];
const process = [
 ['Brief', 'We establish what your business offers, what visitors should do and whether the project fits the scope.'],
 ['Written quote', 'Pages, features, revisions, costs, payment terms, cancellation terms and ownership are agreed in writing.'],
 ['Initial payment', 'The proposed payment split is 50% to begin and 50% before handover, with cancellation terms stated in the quote.'],
 ['Collect content', 'You supply the text, photos and existing branding. The delivery schedule starts once the required materials arrive.'],
 ['Design & build', 'We approve a visual direction before I complete the pages and build the mobile layout.'],
 ['Review', 'For websites, you send one consolidated list of changes. Logo work includes two revision rounds.'],
 ['Test', 'I check mobile layouts, links, agreed forms and the key journeys visitors will take.'],
 ['Handover', 'After final payment, you receive the agreed files, account access and instructions for requesting updates.'],
];
---
<Portfolio>
  <AgencyHero/>
  <section id="work" class="work-section wrap"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Different projects.<br/>The same attention to detail<span class="dot">.</span></h2></div><p>Websites for businesses, communities and independent voices. Explore the visual identity and desktop and phone previews for each project.</p></div><ProjectShowcase projects={selectedProjects}/></section>
  <section id="services" class="services-section pricing-section" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">02 / CLEAR, SIMPLE PRICING</p><h2 id="pricing-title">Pick a starting point.<br/>Build the right package<span class="dot">.</span></h2></div><p>Swipe or drag left and right through each row, or use its arrows to browse the offers.</p></div>
      <section class="pricing-group" aria-label="One-time offers">
        <div class="pricing-group-heading"><div><p class="eyebrow">ONE-TIME OFFERS / {oneTimeOffers.length} OPTIONS</p><p>Swipe, drag or use the arrows to browse.</p></div><div class="pricing-arrows"><button type="button" data-pricing-prev aria-label="Previous one-time offers">←</button><button type="button" data-pricing-next aria-label="Next one-time offers">→</button></div></div>
        <div class="pricing-track" data-pricing-track tabindex="0" role="region" aria-label="One-time offers">
          {oneTimeOffers.map(card=><article class="pricing-card">
            <h3>{card.name}</h3><p class="pricing-description">{card.description}</p><p class="pricing-amount"><strong>{card.price}</strong><span>{card.unit}</span></p><ul>{card.features.map(feature=><li>{feature}</li>)}</ul>{card.info && <details class="pricing-info"><summary aria-label={`More information about ${card.name}`}>i</summary><p>{card.info}</p></details>}<a class="pricing-cta" href="#contact">Ask about this option <span aria-hidden="true">↗</span></a>
          </article>)}
        </div>
      </section>
      <section class="pricing-group pricing-care" aria-label="Subscriptions and care packages">
        <div class="pricing-group-heading"><div><p class="eyebrow">SUBSCRIPTIONS &amp; CARE / {careOffers.length} OPTIONS</p><p>Swipe, drag or use the arrows to browse.</p></div><div class="pricing-arrows"><button type="button" data-pricing-prev aria-label="Previous care packages">←</button><button type="button" data-pricing-next aria-label="Next care packages">→</button></div></div>
        <div class="pricing-track" data-pricing-track tabindex="0" role="region" aria-label="Subscriptions and care packages">
          {careOffers.map(card=><article class="pricing-card">
            <h3>{card.name}</h3><p class="pricing-description">{card.description}</p><p class="pricing-amount"><strong>{card.price}</strong><span>{card.unit}</span></p><ul>{card.features.map(feature=><li>{feature}</li>)}</ul>{card.info && <details class="pricing-info"><summary aria-label={`More information about ${card.name}`}>i</summary><p>{card.info}</p></details>}<a class="pricing-cta" href="#contact">Ask about this option <span aria-hidden="true">↗</span></a>
          </article>)}
        </div>
      </section>
      <div class="pricing-conditions"><div><h3>Domain &amp; hosting</h3><p>We choose the standard domain together, with your approval, and register it in your name. A specific name has no extra fee unless its domain cost exceeds the included 75 AED allowance. A suitable free static hosting tier may be used; any paid hosting is quoted separately. Hosting setup does not include maintenance.</p></div><div><h3>Included with every build</h3><p>Website prices use text and photos you provide. Every build includes 14 days of fixes for faults in my delivered work. Social setup uses your existing branding; ongoing posts, ads and account management are separate.</p></div><div><h3>Website care terms</h3><p>Care is optional and can be cancelled before the next billing month. Update time includes reviewing, editing, checking and publishing. Requests are grouped into one monthly batch for Care or two for Care Plus; unused time does not roll over. Routine updates are handled within three working days.</p></div><div><h3>Requests beyond a care package</h3><p>New pages, redesigns, features and third-party charges are quoted separately. There is no emergency or 24/7 support promise. Any new work is agreed before it begins.</p></div></div>
    </div>
  </section>
  <section class="identity-study wrap" aria-labelledby="identity-title">
    <p class="eyebrow">VISUAL IDENTITY / SELF-INITIATED CONCEPT</p>
    <h2 id="identity-title">Under the Haik.<br/>One identity, across every detail<span class="dot">.</span></h2>
    <p>A visual identity study for my own brand: an illustrated mark, olive lettering and warm neutrals, carried from a small staff-shirt badge to packaging and printed stationery. These mockups explore how the identity can feel consistent across different materials and scales.</p>
    <MockupAccordion />
    <div class="identity-details">
      <div><h3>Colour &amp; typography</h3><p>Dark olive, cream and charcoal give the illustrated mark a quiet, recognisable presence. Classic serif lettering brings the name into the same visual language across stationery, fabric and kraft packaging.</p></div>
      <div><h3>From mark to material</h3><p>A compact logo and name sit on the wearer’s left chest for the staff T-shirt. Larger centred arrangements suit the tote and packaging, while the business cards keep generous space around the identity. These are AI-assisted presentation mockups; production artwork is prepared separately for printing.</p></div>
    </div>
  </section>
  <section id="about" class="about-section wrap"><div class="about-intro"><p class="eyebrow">03 / THE PERSON BEHIND THE BUILD</p><h2>A design eye.<br/>A technical mindset<span class="dot">.</span></h2><div class="about-mark" aria-hidden="true">&lt; / &gt;<span>DESIGN MEETS DEVELOPMENT</span></div></div><div class="about-copy"><p class="large-copy">Hi, I’m ken.lou, the designer and developer behind Under the Haik. I’m based in Dubai, with a background in cybersecurity, systems administration and networking.</p><p>That background helps me think beyond the page: how a website is hosted, how it is maintained and how the parts connect. I bring that care to websites that are straightforward to use and practical to manage.</p><h3>What that means for your project</h3><div class="strengths"><div><h4>Built on solid foundations</h4><p>Infrastructure knowledge and security awareness inform hosting choices, updates and how forms and integrations are handled.</p></div><div><h4>Ready for real screens</h4><p>Layouts, navigation and images are considered across phones, tablets and desktop screens.</p></div><div><h4>Clear from the start</h4><p>We agree on scope and priorities, with clear communication through design, review and handover.</p></div><div><h4>Help beyond the design</h4><p>I can handle domains, hosting and deployment, with accounts owned by you and clear instructions for future changes.</p></div></div></div></section>
  <section id="process" class="process-section wrap"><div class="section-heading"><div><p class="eyebrow">04 / HOW WE GET THERE</p><h2>A clear process.<br/>From first chat to launch<span class="dot">.</span></h2></div><p>You’ll know what we’re working on, what comes next and where your feedback fits.</p></div><ol class="process-grid">{process.map(([name,description],i)=><li><span class="step-number">0{i+1}<span aria-hidden="true">↗</span></span><h3>{name}</h3><p>{description}</p></li>)}</ol></section>
  <section class="agency-faq wrap"><p class="eyebrow">BEFORE WE BEGIN</p><h2>Your website questions, answered.</h2><details><summary>Will my website work on phones?</summary><p>Yes. Every website includes a responsive layout, with the main pages and visitor journeys checked on desktop and phone screens.</p></details><details><summary>How much does a website cost?</summary><p>Introductory prices start at 350 AED for a one-page website and 500 AED for a simple business website. The 1,000 AED launch bundle combines a website and starter visual identity. Domain and provider costs are quoted separately.</p></details><details><summary>How do we get started?</summary><p>Ready to begin? Send me your business details, the pages you need, your budget and your preferred launch date. We agree on a written scope and quote before work starts.</p></details><details><summary>Can you create my logo and colours too?</summary><p>Yes. Logo design on its own is 300 AED and includes two design directions, two revision rounds and final files. The expanded 600 AED starter identity adds a colour palette, font pairing, short guidelines and a profile image.</p></details><details><summary>What happens after launch?</summary><p>You receive the agreed files and account access. You have 14 days to report faults in the agreed work. Content updates are quoted before work begins.</p></details></section>
  <PortfolioContact/>
</Portfolio>

<script>
  const connectTrack = (group: HTMLElement) => {
    const track = group.querySelector<HTMLElement>('[data-pricing-track]');
    if (!track) return;
    const step = () => (track.querySelector<HTMLElement>('.pricing-card')?.getBoundingClientRect().width || track.clientWidth * .8) + 16;
    group.querySelector<HTMLButtonElement>('[data-pricing-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    group.querySelector<HTMLButtonElement>('[data-pricing-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    let pointerStart = 0;
    let scrollStart = 0;
    let dragged = false;
    track.addEventListener('pointerdown', event => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      pointerStart = event.clientX;
      scrollStart = track.scrollLeft;
      dragged = false;
    });
    track.addEventListener('pointermove', event => {
      if (!event.buttons || event.pointerType !== 'mouse') return;
      const delta = event.clientX - pointerStart;
      if (Math.abs(delta) > 4) {
        dragged = true;
        track.classList.add('is-dragging');
        track.scrollLeft = scrollStart - delta;
      }
    });
    const finishDrag = () => track.classList.remove('is-dragging');
    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);
    track.addEventListener('click', event => {
      if (dragged) { event.preventDefault(); event.stopPropagation(); dragged = false; }
    }, true);
  };
  document.querySelectorAll<HTMLElement>('.pricing-group').forEach(connectTrack);
</script>

