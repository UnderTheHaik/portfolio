---
import AgencyHero from '../components/AgencyHero.astro';
import LaunchPrice from '../components/LaunchPrice.astro';

import Portfolio from '../layouts/Portfolio.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import PortfolioContact from '../components/PortfolioContact.astro';
import MockupAccordion from '../components/MockupAccordion.astro';
import { projects } from '../lib/portfolio';
import { url } from '../lib/content';
import '../styles/pricing.css';
const selectedProjects = ['sift-and-saffron', 'noura-beauty-house', 'crumb-and-cup', 'serenas-sanctuary', 'the-table-restaurant', 'loom-and-kiln', 'brightpath-academy', 'second-story', 'les-mots-dun-montagnard', 'her-circle'].map(slug => projects.find(project => project.slug === slug)!);
const mainOffers = [
  { name: 'One-page website', price: 650, description: 'A focused website for a small business.', features: ['Up to six sections', 'Responsive layout', 'Contact links and basic SEO setup', 'One revision round'] },
  { name: 'Business website', price: 1200, description: 'A practical home for your services.', features: ['Up to five simple pages', 'Responsive layout', 'Basic SEO setup and contact links', 'Two revision rounds'] },
  { name: 'Complete launch', price: 1700, description: 'Your website, identity and social profiles together.', features: ['Business website', 'Starter visual identity', 'Instagram + Facebook setup', 'Save 200 AED on regular separate prices'] },
];
const oneTimeOffers = [
  { name: 'Starter visual identity', price: 500, description: 'A consistent visual foundation for your business.', features: ['Logo, colour palette and font pairing', 'One-page brand guide', 'Two initial design directions', 'Two revision rounds on the chosen direction', 'Final SVG and transparent PNG logo files'] },
  { name: 'Instagram + Facebook setup', price: 200, description: 'Both profiles set up with your existing branding.', features: ['Profile setup, bio and contact details', 'Profile and cover images', 'You own both accounts', 'Ongoing posts and ads are separate'] },
  { name: 'Website + identity', price: 1550, description: 'A website and visual identity in one package.', features: ['Business website', 'Starter visual identity', 'Save 150 AED on regular separate prices'] },
  { name: 'Complete launch + domain setup', price: 1900, description: 'Your complete launch with first-year domain and hosting setup.', features: ['Complete launch package', 'Domain and hosting setup as described below', 'Domain allowance up to 75 AED', 'Save 200 AED on regular separate prices'] },
];
const careOffers = [
  { name: 'Domain & hosting setup', price: '200', unit: 'AED · year one', description: 'Your web address connected and ready to use.', features: ['Domain registration costing up to 75 AED', 'Domain connection and HTTPS', 'Setup on a suitable free static hosting tier', 'Register the domain in your name', 'Higher domain purchase cost and paid hosting are additional; agreed first'] },
  { name: 'Pay-as-you-go changes', price: '100', unit: 'AED minimum', description: 'Small changes, quoted before work starts.', features: ['Up to 30 minutes of work', 'Additional time: 75 AED per 30 minutes', 'Time includes review, editing, checks and publishing'] },
  { name: 'Website Care', price: '150', unit: 'AED / month', description: 'Regular checks and grouped content updates.', features: ['Monthly link and contact checks', 'Source backup', 'Up to 45 minutes of content updates', 'One monthly batch'] },
  { name: 'Website Care Plus', price: '300', unit: 'AED / month', description: 'More update time for your website.', features: ['Monthly link and contact checks', 'Source backup', 'Up to two hours of updates', 'Two monthly batches', 'A simple promotional banner can use this allowance'] },
  { name: 'Annual renewal management', price: '100', unit: 'AED / year + provider charges', description: 'Renewal coordination and a connection check.', features: ['Domain and HTTPS connection check', 'Provider charges billed separately', 'Management fee waived for active monthly care clients'] },
];
const extras = [
  ['Additional simple page', '200 AED / page', 'Using the approved design'],
  ['Additional website revision round', '150 AED', 'Up to one hour'],
  ['Additional logo revision round', '100 AED', 'Up to 30 minutes'],
  ['Second language version', 'From 50% of the website build price', 'Client-supplied translations'],
  ['Third-party booking or form integration', 'From 150 AED', 'Subscriptions charged separately'],
];
const process = [
 ['Brief', 'We establish what your business offers, what visitors should do and whether the project fits the scope.'],
 ['Written quote', 'Pages, features, revisions, costs, payment terms, cancellation terms and ownership are agreed in writing.'],
 ['Initial payment', 'The proposed payment split is 50% to begin and 50% before handover, with cancellation terms stated in the quote.'],
 ['Collect content', 'You supply the text, photos and existing branding. The delivery schedule starts once the required materials arrive.'],
 ['Design & build', 'We approve a visual direction before I complete the pages and build the mobile layout.'],
 ['Review', 'Each website revision round uses one consolidated list of changes. One-page websites include one round; business websites and logo work include two.'],
 ['Test', 'I check mobile layouts, links, agreed forms and the key journeys visitors will take.'],
 ['Handover', 'After final payment, you receive the agreed files, account access and instructions for requesting updates.'],
];
---
<Portfolio>
  <AgencyHero/>
  <section id="work" class="work-section wrap"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Different projects.<br/>The same attention to detail<span class="dot">.</span></h2></div><p>Websites for businesses, communities and independent voices. Preview each project on laptop and phone, then visit its website.</p></div><ProjectShowcase projects={selectedProjects}/></section>
  <section id="services" class="services-section pricing-section" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">02 / CLEAR, SIMPLE PRICING</p><h2 id="pricing-title">Pick a starting point.<br/>Build the right package<span class="dot">.</span></h2></div><p>Static websites and visual identities with a clear scope, direct communication and a written quote.</p></div>
      <div class="launch-notice"><span class="launch-badge">Launch offer — 50% off</span><p>Half-price website, identity and social setup packages. Regular prices are shown beside your launch price. Domains, updates, monthly care, renewal management and extras use the rates listed below.</p></div>
      <div class="pricing-main" aria-label="Main website packages">
        {mainOffers.map(card=><article class="pricing-card"><span class="pricing-offer-mark">Launch special · 50% off</span><h3>{card.name}</h3><p class="pricing-description">{card.description}</p><LaunchPrice price={card.price}/><ul>{card.features.map(feature=><li>{feature}</li>)}</ul><a class="pricing-cta" href="#contact">Discuss this package <span aria-hidden="true">↗</span></a></article>)}
      </div>
      <section class="pricing-group" aria-label="Identity, social setup and other bundles">
        <div class="pricing-group-heading"><div><p class="eyebrow">IDENTITY, SOCIAL SETUP &amp; OTHER BUNDLES</p><p>Explore the other launch offers.</p></div></div>
        <div class="pricing-track" data-pricing-track tabindex="0" role="region" aria-label="Other launch offers">
          {oneTimeOffers.map(card=><article class="pricing-card"><span class="pricing-offer-mark">Launch special · 50% off</span><h3>{card.name}</h3><p class="pricing-description">{card.description}</p><LaunchPrice price={card.price}/><ul>{card.features.map(feature=><li>{feature}</li>)}</ul><a class="pricing-cta" href="#contact">Ask about this option <span aria-hidden="true">↗</span></a></article>)}
        </div>
      </section>
      <section class="pricing-group pricing-care" aria-label="Domains, updates and care">
        <div class="pricing-group-heading"><div><p class="eyebrow">DOMAINS, UPDATES &amp; ONGOING CARE</p><p>Standard rates · swipe or use the arrows to browse.</p></div><div class="pricing-arrows"><button type="button" data-pricing-prev aria-label="Previous care packages">←</button><button type="button" data-pricing-next aria-label="Next care packages">→</button></div></div>
        <div class="pricing-track" data-pricing-track tabindex="0" role="region" aria-label="Domains, updates and care">
          {careOffers.map(card=><article class="pricing-card"><h3>{card.name}</h3><p class="pricing-description">{card.description}</p><p class="pricing-amount"><strong>{card.price}</strong><span>{card.unit}</span></p><ul>{card.features.map(feature=><li>{feature}</li>)}</ul><a class="pricing-cta" href="#contact">Ask about this option <span aria-hidden="true">↗</span></a></article>)}
        </div>
      </section>
      <details class="pricing-extras"><summary>A little extra, clearly priced.</summary><div class="extras-table-wrap"><table><caption class="sr-only">Additional work at standard rates</caption><thead><tr><th scope="col">Extra</th><th scope="col">Price</th><th scope="col">Scope</th></tr></thead><tbody>{extras.map(([name,price,scope])=><tr><th scope="row">{name}</th><td>{price}</td><td>{scope}</td></tr>)}</tbody></table></div></details>
      <div class="pricing-conditions"><div><h3>Domain &amp; hosting</h3><p>Choose your preferred available domain with no extra selection fee. Registration includes a 75 AED domain allowance; only purchase costs above that allowance are additional and agreed before buying. The domain is registered in your name. Paid hosting is additional. Setup does not include maintenance.</p></div><div><h3>Included with every build</h3><p>Prices cover static websites in one language, client-supplied text and photographs, and an agreed design direction. Every build includes 14 days of corrections for faults in my delivered work. Content changes use the update rates. Social setup uses your existing branding; ongoing posts, ads and account management are separate.</p></div><div><h3>Website care terms</h3><p>Care is optional and can be cancelled before the next billing month. Time includes reviewing, editing, checking and publishing. Care includes one monthly batch; Care Plus includes two. Unused time does not roll over. Routine updates are handled within three working days. Annual renewal management is waived while monthly care is active; provider charges still apply.</p></div><div><h3>Work quoted separately</h3><p>Custom booking systems, checkout, user accounts, extensive animation and copywriting need a separate quote. Extras above use the approved design and stated time limits. Any new work is agreed before it begins.</p></div></div>
    </div>
  </section>
  <section class="identity-study wrap" aria-labelledby="identity-title">
    <p class="eyebrow">VISUAL IDENTITY / SELF-INITIATED CONCEPT</p>
    <h2 id="identity-title">Under the Haik.<br/>One identity, across every detail<span class="dot">.</span></h2>
    <p>A visual identity study for my own brand: an illustrated mark, olive lettering and warm neutrals, carried from a small staff-shirt badge to packaging and printed stationery. These mockups explore how the identity can feel consistent across different materials and scales.</p>
    <MockupAccordion />
    <div class="identity-details">
      <div><h3>Colour &amp; typography</h3><p>Dark olive, cream and charcoal give the illustrated mark a quiet, recognisable presence. Classic serif lettering brings the name into the same visual language across stationery, fabric and kraft packaging.</p></div>
      <div><h3>From mark to material</h3><p>A compact logo and name sit on the wearer’s left chest for the staff T-shirt. Larger centred arrangements suit the tote and packaging, while the business cards keep generous space around the identity. These are AI-assisted presentation mockups; production artwork is prepared separately for printing.</p></div>
    </div>
  </section>
  <section id="about" class="about-section wrap"><div class="about-intro"><p class="eyebrow">03 / THE PERSON BEHIND THE BUILD</p><h2>A design eye.<br/>A technical mindset<span class="dot">.</span></h2><div class="about-mark" aria-hidden="true">&lt; / &gt;<span>DESIGN MEETS DEVELOPMENT</span></div></div><div class="about-copy"><p class="large-copy">Hi, I’m ken.lou, the designer and developer behind Under the Haik. I’m based in Dubai, with a background in cybersecurity, systems administration and networking.</p><p>That background helps me think beyond the page: how a website is hosted, how it is maintained and how the parts connect. I bring that care to websites that are straightforward to use and practical to manage.</p><h3>What that means for your project</h3><div class="strengths"><div><h4>Built on solid foundations</h4><p>Infrastructure knowledge and security awareness inform hosting choices, updates and how forms and integrations are handled.</p></div><div><h4>Ready for real screens</h4><p>Layouts, navigation and images are considered across phones, tablets and desktop screens.</p></div><div><h4>Clear from the start</h4><p>We agree on scope and priorities, with clear communication through design, review and handover.</p></div><div><h4>Help beyond the design</h4><p>I can handle domains, hosting and deployment, with accounts owned by you and clear instructions for future changes.</p></div></div></div></section>
  <section id="process" class="process-section wrap"><div class="section-heading"><div><p class="eyebrow">04 / HOW WE GET THERE</p><h2>A clear process.<br/>From first chat to launch<span class="dot">.</span></h2></div><p>You’ll know what we’re working on, what comes next and where your feedback fits.</p></div><ol class="process-grid">{process.map(([name,description],i)=><li><span class="step-number">0{i+1}<span aria-hidden="true">↗</span></span><h3>{name}</h3><p>{description}</p></li>)}</ol></section>
  <section class="agency-faq wrap"><p class="eyebrow">BEFORE WE BEGIN</p><h2>Your website questions, answered.</h2><details><summary>Will my website work on phones?</summary><p>Yes. Every website includes a responsive layout, with the main pages and visitor journeys checked on desktop and phone screens.</p></details><details><summary>How much does a website cost?</summary><p>Regular prices are 650 AED for a one-page website, 1,200 AED for a business website and 1,700 AED for Complete launch. The launch offer takes 50% off these packages: 325, 600 and 850 AED respectively. Domain setup, care, extras and provider charges are separate unless included in your chosen bundle.</p></details><details><summary>How do we get started?</summary><p>Ready to begin? Send me your business details, the pages you need, your budget and your preferred launch date. We agree on a written scope and quote before work starts.</p></details><details><summary>Can you create my logo and colours too?</summary><p>Yes. Starter visual identity is 500 AED regularly, or 250 AED with the launch offer. It includes a logo, colour palette, font pairing, one-page brand guide, two initial directions and two revision rounds on the chosen direction.</p></details><details><summary>What happens after launch?</summary><p>You receive the agreed files and account access. You have 14 days to report faults in the agreed work. Content updates are quoted before work begins.</p></details></section>
  <PortfolioContact/>
</Portfolio>

<script>
  const connectTrack = (group: HTMLElement) => {
    const track = group.querySelector<HTMLElement>('[data-pricing-track]');
    if (!track) return;
    const step = () => (track.querySelector<HTMLElement>('.pricing-card')?.getBoundingClientRect().width || track.clientWidth * .8) + 16;
    group.querySelector<HTMLButtonElement>('[data-pricing-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    group.querySelector<HTMLButtonElement>('[data-pricing-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    let pointerStart = 0;
    let scrollStart = 0;
    let dragged = false;
    track.addEventListener('pointerdown', event => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      pointerStart = event.clientX;
      scrollStart = track.scrollLeft;
      dragged = false;
    });
    track.addEventListener('pointermove', event => {
      if (!event.buttons || event.pointerType !== 'mouse') return;
      const delta = event.clientX - pointerStart;
      if (Math.abs(delta) > 4) {
        dragged = true;
        track.classList.add('is-dragging');
        track.scrollLeft = scrollStart - delta;
      }
    });
    const finishDrag = () => track.classList.remove('is-dragging');
    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);
    track.addEventListener('click', event => {
      if (dragged) { event.preventDefault(); event.stopPropagation(); dragged = false; }
    }, true);
  };
  document.querySelectorAll<HTMLElement>('.pricing-group').forEach(connectTrack);
</script>

