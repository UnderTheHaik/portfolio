---
import Portfolio from '../../layouts/Portfolio.astro';
import PortfolioContact from '../../components/PortfolioContact.astro';
import { services } from '../../lib/services';
import { projects } from '../../lib/portfolio';
import { url } from '../../lib/content';
import { Image } from 'astro:assets';
import '../../styles/services.css';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const examples = service.examples.map(slug => projects.find(project => project.slug === slug)!);
---
<Portfolio title={service.title} description={service.description}>
  <header class="service-hero wrap"><p class="eyebrow">UNDER THE HAIK · SERVICES</p><h1>{service.title}</h1><p>{service.intro}</p><a class="button" href="#contact">Request a quote ↗</a></header>
  <article class="service-document wrap">
    <div class="service-content"><h2>{service.heading}</h2>{service.paragraphs.map(paragraph => <p>{paragraph}</p>)}<h2>What’s included</h2><ul>{service.includes.map(item => <li>{item}</li>)}</ul><h2>Is this the right starting point?</h2><p>{service.fit}</p></div>
    <aside class="service-scope" aria-label="Package scope and pricing"><h2>Clear scope. Clear price.</h2>{service.launch !== null ? <><p class="service-price">{service.launch.toLocaleString('en-US')} <span>AED</span></p><p>Launch offer · 50% off</p><p>Regular price: {service.regular!.toLocaleString('en-US')} AED</p></> : <><p class="service-price">150 <span>AED / month</span></p><p>Care Plus: 300 AED / month</p><p>Standard rates; launch discount does not apply.</p></>}<p>{service.separate}</p><a class="text-link" href={url('#services')}>Compare all packages ↗</a><a class="text-link" href={url('guides/website-cost-dubai/')}>Read the website cost guide ↗</a></aside>
  </article>
  <section class="service-examples wrap"><h2>Explore the design work</h2><p>These case studies show the design approach. Concepts are labelled clearly and do not claim client results.</p><div>{examples.map(project => <a href={url(`work/${project.slug}/`)}><Image src={project.image} alt={`${project.name} website design preview`} widths={[480,800]} sizes="(max-width:700px) 90vw, 44vw" format="webp" loading="lazy"/><h3>{project.name}</h3><p>{project.type}</p><span>View case study ↗</span></a>)}</div></section>
  <section class="service-faq wrap"><h2>Before you begin</h2>{service.faqs.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}<p>Send your business details, required pages, available content, budget and preferred launch date. We agree the scope, payment and cancellation terms in writing before work starts.</p></section>
  <PortfolioContact/>
</Portfolio>
