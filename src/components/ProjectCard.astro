---
import { Image } from 'astro:assets';
import { url } from '../lib/content';
import { projects } from '../lib/portfolio';
import { getProjectCaptures } from '../lib/project-captures';
interface Props { project: typeof projects[number]; index: number; }
const {project, index} = Astro.props;
const preview = getProjectCaptures(project.slug)[0];
---
<article class:list={['project-card',project.color,{'featured-project':index===0}]}>
  <a class="project-shot" href={url(`work/${project.slug}/`)} aria-label={`Read ${project.name} case study`}>
    <span class="browser-strip" aria-hidden="true"><i></i><i></i><i></i><span>{project.name.toLowerCase()}</span></span>
    <Image src={preview?.laptop || project.image} alt={`${project.name} website homepage on a laptop`} widths={[480,800,1200,1440]} sizes={index===0?'(max-width: 700px) 92vw, 88vw':'(max-width: 700px) 92vw, 44vw'} format="webp" quality={82} loading="lazy"/>
    {preview && <span class="phone-preview"><Image src={preview.phone} alt={`${project.name} website homepage on a phone`} widths={[160,240,390]} sizes="(max-width: 700px) 18vw, 12vw" format="webp" quality={82} loading="lazy"/></span>}
    <span class="shot-cta" aria-hidden="true">View case study ↗</span>
  </a>
  <div class="project-details"><div><p class="eyebrow">{project.category}</p><h3><a href={url(`work/${project.slug}/`)}>{project.name}<span aria-hidden="true">↗</span></a></h3><p>{project.summary}</p></div><span class="project-type">{project.type}</span></div>
  <a class="screenshots-link" href={url(`work/${project.slug}/#screenshots`)}>Explore pages & device views <span aria-hidden="true">↗</span></a>
</article>
