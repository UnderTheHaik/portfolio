---
import '../styles/portfolio.css';
import '../styles/agency.css';
import '../styles/showcase.css';
import { Image } from 'astro:assets';
import logo from '../assets/portfolio/logo.png';
import { url } from '../lib/content';
import { services } from '../lib/services';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const {title = 'Affordable web design in Dubai', description = 'Launch your small business online with affordable web design and visual identity in Dubai. Explore the portfolio and request a clear, tailored quote.', image, noindex = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} — Under the Haik`;
const socialImage = new URL(image || url('images/portfolio/under-the-haik-share-v2.jpg'), Astro.site);
const nav = ['Work', 'Services', 'About', 'Process', 'Contact'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
  {noindex && <meta name="robots" content="noindex, follow"/>}
  <meta name="theme-color" content="#f6f4ed"/><link rel="icon" href={url('portfolio-favicon.png')} type="image/png" sizes="48x48"/><link rel="apple-touch-icon" href={url('portfolio-touch-icon.png')}/>
  <meta property="og:type" content="website"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta property="og:image:alt" content="Under the Haik web design and development portfolio"/><meta property="og:site_name" content="Under the Haik"/>
  {!image && <><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:type" content="image/jpeg"/></>}
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="Under the Haik — web and visual design in Dubai"/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ProfessionalService',name:'Under the Haik',url:Astro.site?.href,description:'Independent web design and visual identity for small businesses in Dubai and across the UAE.',areaServed:'United Arab Emirates',knowsAbout:['Web design','Web development','Visual identity','Responsive design']})}/>
{Astro.url.pathname !== url() && <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL(url(),Astro.site).href},{'@type':'ListItem',position:2,name:title,item:canonical.href}]})}/>}
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href={url()} aria-label="Under the Haik home"><Image class="brand-icon" src={logo} alt="" width={64} height={64} widths={[64,128]} sizes="64px" format="webp" loading="eager"/><span>under the haik<span class="brand-caption">WEB & VISUAL DESIGN</span></span></a>
    <nav aria-label="Main navigation">{nav.map(item => <a href={item === 'About' ? url('about/') : item === 'Contact' ? url('contact/') : `${url()}#${item.toLowerCase()}`} class:list={{'nav-contact':item==='Contact'}}>{item}<span aria-hidden="true">{item==='Contact'?' ↗':''}</span></a>)}</nav>
  </header>
  <main id="main" tabindex="-1"><slot/></main>
  <a class="back-to-top" href="#top" aria-label="Back to top" hidden><span aria-hidden="true">↑</span></a>
  <nav class="service-directory wrap" aria-label="Design services">{services.map(service => <a href={url(`services/${service.slug}/`)}>{service.label}</a>)}<a href={url("guides/website-cost-dubai/")}>Website cost guide</a><a href={url("privacy/")}>Privacy</a></nav>
  <footer class="site-footer wrap"><a class="footer-brand" href={url()}><Image class="footer-logo" src={logo} alt="" width={48} height={48} widths={[48,96]} sizes="48px" format="webp" loading="lazy"/><span>under the haik<span class="dot">.</span></span></a><p>Independent web & visual design · Dubai, UAE</p><div><span>© {new Date().getFullYear()} Under the Haik</span><a href={`${url()}#work`}>Back to work ↑</a></div></footer>
</body>
</html>
<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const backToTop = document.querySelector<HTMLAnchorElement>('.back-to-top');
  const updateBackToTop = () => { if (backToTop) backToTop.hidden = window.scrollY < 400; };
  window.addEventListener('scroll', updateBackToTop, { passive: true });
  updateBackToTop();
  backToTop?.addEventListener('click', event => {
    event.preventDefault();
    window.scrollTo({ top: 0, behavior: motion.matches ? 'instant' : 'smooth' });
    document.querySelector<HTMLAnchorElement>('.skip')?.focus({ preventScroll: true });
  });
  const mouse = matchMedia('(hover: hover) and (pointer: fine)');
  const cards = [...document.querySelectorAll<HTMLElement>('.carousel-track .project-card, .showcase-preview')];
  let frame = 0;
  window.addEventListener('pointermove',event => {
    if(motion.matches || !mouse.matches) return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      cards.forEach(card => {
        const rect = card.getBoundingClientRect();
        const dx = Math.max(rect.left-event.clientX,0,event.clientX-rect.right);
        const dy = Math.max(rect.top-event.clientY,0,event.clientY-rect.bottom);
        const proximity = Math.max(0,1-Math.hypot(dx,dy)/180);
        card.style.setProperty('--near-scale',String(1+proximity*.025));
      });
    });
  },{passive:true});
  const reset = () => cards.forEach(card => card.style.removeProperty('--near-scale'));
  document.documentElement.addEventListener('pointerleave',reset);
  motion.addEventListener('change',reset);
</script>
