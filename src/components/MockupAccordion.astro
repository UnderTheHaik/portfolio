---
import { url } from '../lib/content';
const mockups = [
 ['business-card', 'Business cards', 'Cream textured business cards with the Under the Haik logo and olive serif lettering'],
 ['tshirt', 'Staff T-shirt', 'White staff T-shirt with a small Under the Haik logo and name on the left chest'],
 ['box', 'Kraft box', 'Kraft packaging box printed with the Under the Haik illustrated logo and brand name'],
 ['packaging-set', 'Bags & gift tag', 'Under the Haik branding on a drawstring pouch, paper shopping bag and kraft gift tag'],
 ['pouch', 'Kraft pouch', 'Kraft pouch with the Under the Haik logo above the olive brand name'],
 ['tote', 'Canvas tote', 'Natural canvas tote bag with the Under the Haik logo and serif brand name'],
];
---
<div class="mockup-accordion" aria-label="Brand identity mockups">
 {mockups.map(([file,label,alt],i)=><section class:list={['mockup-panel',{'is-active':i===0}]}><button class="mockup-trigger" type="button" aria-expanded={i===0?'true':'false'} aria-controls={`mockup-${file}`}><span class="mockup-number">0{i+1}</span><span class="mockup-label">{label}</span><span class="mockup-plus" aria-hidden="true">↗</span></button><div class="mockup-image" id={`mockup-${file}`} hidden={i!==0}><img src={url('images/portfolio/identity/under-the-haik-'+file+'.webp')} alt={alt} width="1200" height="800" loading="lazy" decoding="async"/></div></section>)}
</div>
<style>
.mockup-accordion{display:flex;gap:0;min-height:520px;margin-top:35px;border-radius:24px;overflow:hidden;background:#e5e9df}.mockup-panel{position:relative;flex:0 0 8%;min-width:0;overflow:hidden;background:#d7dfcd;transition:flex .6s cubic-bezier(.22,.65,.25,1)}.mockup-panel:nth-child(2n){background:#c8d3bc}.mockup-panel:nth-child(3n){background:#bac7aa}.mockup-panel.is-active{flex:1;background:#ece9de}.mockup-trigger{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:25px 12px;background:transparent;color:#26382a;border:0;width:100%;cursor:pointer;text-align:left}.mockup-number{border:1px solid #26382a55;border-radius:50%;width:40px;height:40px;display:grid;place-items:center;font-size:.75rem}.mockup-label{writing-mode:vertical-rl;rotate:180deg;font-size:1.1rem;font-weight:700;white-space:nowrap}.mockup-plus{font-size:1.5rem}.is-active .mockup-trigger{inset:0 0 auto;height:80px;flex-direction:row;padding:20px 25px;background:linear-gradient(#f4f0e9fa,#f4f0e9cc)}.is-active .mockup-label{writing-mode:horizontal-tb;rotate:none;font-size:1.3rem}.mockup-trigger:focus-visible{outline:3px solid #9e4b36;outline-offset:-5px}.mockup-image{height:520px;padding-top:80px}.mockup-image img{width:100%;height:100%;object-fit:contain;animation:none}.mockup-image[hidden]{display:none}@media(max-width:700px){.mockup-accordion{display:block;min-height:0;border-radius:18px}.mockup-panel{height:64px;transition:height .45s ease}.mockup-panel.is-active{height:370px}.mockup-trigger,.is-active .mockup-trigger{height:64px;flex-direction:row;padding:12px 18px}.mockup-label,.is-active .mockup-label{writing-mode:horizontal-tb;rotate:none;font-size:1rem}.mockup-number{width:32px;height:32px}.mockup-image{height:370px;padding-top:64px}.mockup-plus{font-size:1.2rem}}@media(prefers-reduced-motion:reduce){.mockup-panel{transition:none}}
</style>
<script>
 document.querySelectorAll<HTMLElement>('.mockup-accordion').forEach(accordion=>{
 const panels=[...accordion.querySelectorAll<HTMLElement>('.mockup-panel')];
 const activate=(panel:HTMLElement)=>panels.forEach(item=>{const active=item===panel;item.classList.toggle('is-active',active);item.querySelector('button')!.setAttribute('aria-expanded',String(active));(item.querySelector('.mockup-image') as HTMLElement).hidden=!active;});
 panels.forEach((panel,index)=>{const button=panel.querySelector('button')!;button.addEventListener('click',()=>activate(panel));button.addEventListener('focus',()=>activate(panel));panel.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse')activate(panel);});button.addEventListener('keydown',event=>{if(!['ArrowRight','ArrowDown','ArrowLeft','ArrowUp','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?panels.length-1:(index+(event.key==='ArrowRight'||event.key==='ArrowDown'?1:-1)+panels.length)%panels.length;panels[next].querySelector('button')!.focus();});});
 });
</script>
