---
import Portfolio from '../layouts/Portfolio.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortfolioContact from '../components/PortfolioContact.astro';
import { projects } from '../lib/portfolio';
const services = [
 ['Business websites', 'A clear, useful home for your business. Built to explain what you offer and make getting in touch easy.'],
 ['Landing pages', 'Focused pages for a product, campaign or launch, with one clear next step.'],
 ['WordPress websites', 'Flexible websites with a content workflow you can manage after launch.'],
 ['E-commerce', 'Product-led storefronts with considered browsing, product details and checkout setup.'],
 ['Website redesign', 'A fresh structure and visual direction for a website that no longer fits your business.'],
 ['Maintenance', 'Updates, fixes and ongoing care to keep your website useful and dependable.'],
 ['Front-end development', 'Responsive interfaces and custom development when your project needs more than a template.'],
];
const process = [
 ['Discovery', 'We talk about your business, audience, goals and the scope of your website.'],
 ['Structure', 'I map the pages, content and paths visitors need to find what matters.'],
 ['Design', 'We define the visual direction, typography and key layouts before building.'],
 ['Development', 'I build the responsive website and connect the features we agreed on.'],
 ['Review', 'We review content, test key journeys and check the site on different screen sizes.'],
 ['Launch', 'I handle deployment, domain setup and a practical handover for future updates.'],
];
---
<Portfolio>
  <section class="hero wrap"><div class="hero-topline"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> INDEPENDENT DESIGNER & DEVELOPER</p><span class="location">Dubai, UAE <span aria-hidden="true">↗</span></span></div><h1>Websites designed<br/>to actually <em>work</em><br/>for your business<span class="dot">.</span></h1><div class="hero-bottom"><div><p>I design and build responsive websites for small businesses, creators and communities in the UAE.</p><div class="hero-actions"><a class="button" href="#work">View my work <span aria-hidden="true">↓</span></a><a class="text-link" href="#contact">Start a project <span aria-hidden="true">↗</span></a></div></div><p class="hero-aside">Thoughtful design.<br/>Solid technical foundations.<br/>A website you can build on.</p></div><div class="hero-foot"><span>DESIGN WITH PURPOSE. BUILD WITH CARE.</span><span>SCROLL TO EXPLORE ↓</span></div></section>
  <section id="work" class="work-section wrap"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Different projects.<br/>The same attention to detail<span class="dot">.</span></h2></div><p>A selection of concept, personal and family projects. Explore the design, the build and the thinking behind each one.</p></div><div class="projects-grid">{projects.map((project,index)=><ProjectCard project={project} index={index}/>)}</div></section>
  <section id="services" class="services-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / WHAT I CAN HELP WITH</p><h2>From your first website<br/>to your next chapter<span class="dot">.</span></h2></div><p>Practical websites for small businesses, entrepreneurs, creators, community organisations and online shops.</p></div><div class="services-list">{services.map(([name,description],i)=><div class="service"><span class="service-number">0{i+1}</span><h3>{name}</h3><p>{description}</p><span class="service-arrow" aria-hidden="true">↗</span></div>)}</div><a class="text-link" href="#contact">Let’s find the right fit for your project <span aria-hidden="true">↗</span></a></div></section>
  <section id="about" class="about-section wrap"><div class="about-intro"><p class="eyebrow">03 / THE PERSON BEHIND THE BUILD</p><h2>A design eye.<br/>A technical mindset<span class="dot">.</span></h2><div class="about-mark" aria-hidden="true">&lt; / &gt;<span>DESIGN MEETS DEVELOPMENT</span></div></div><div class="about-copy"><p class="large-copy">Hi, I’m ken.lou, the designer and developer behind Under the Haik. I’m based in Dubai, with a background in cybersecurity, systems administration and networking.</p><p>That background helps me think beyond the page: how a website is hosted, how it is maintained and how the parts connect. I bring that care to websites that are straightforward to use and practical to manage.</p><h3>What that means for your project</h3><div class="strengths"><div><h4>Built on solid foundations</h4><p>Infrastructure knowledge and security awareness inform hosting choices, updates and how forms and integrations are handled.</p></div><div><h4>Ready for real screens</h4><p>Layouts, navigation and images are considered across phones, tablets and desktop screens.</p></div><div><h4>Clear from the start</h4><p>We agree on scope and priorities, with clear communication through design, review and handover.</p></div><div><h4>Help beyond the design</h4><p>I can handle domains, hosting and deployment, with custom development when the project calls for it.</p></div></div></div></section>
  <section id="process" class="process-section wrap"><div class="section-heading"><div><p class="eyebrow">04 / HOW WE GET THERE</p><h2>A clear process.<br/>From first chat to launch<span class="dot">.</span></h2></div><p>You’ll know what we’re working on, what comes next and where your feedback fits.</p></div><ol class="process-grid">{process.map(([name,description],i)=><li><span class="step-number">0{i+1}<span aria-hidden="true">↗</span></span><h3>{name}</h3><p>{description}</p></li>)}</ol></section>
  <PortfolioContact/>
</Portfolio>
